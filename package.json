{
  "name": "roostbot",
  "private": true,
  "version": "0.1.0",
  "description": "Roost Bot — a team of bots that lives on a cloud machine and can reach back into your local DSH.",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "check": "node --experimental-strip-types --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "test": "node --experimental-strip-types --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "dev:api": "node --experimental-strip-types apps/api/src/main.ts",
    "errors": "node scripts/error-codes.mjs",
    "release": "node scripts/release.mjs",
    "e2e": "sh scripts/e2e-cloud.sh"
  },
  "license": "Apache-2.0",
  "type": "module"
}
