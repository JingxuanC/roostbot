<view class="page">
  <view class="brand">
    <text class="title">Roost Bot</text>
    <text class="sub">连接你的云上 Bot 团队</text>
  </view>

  <view class="card">
    <text class="label">配对码</text>
    <input class="code-input" type="number" maxlength="6" placeholder="6 位数字"
           value="{{code}}" bindinput="onCodeInput" confirm-type="done" />
    <text class="hint">在已登录的 Web 控制面点「生成配对码」，然后在这里输入。配对一次即可，之后自动登录。</text>
    <button class="btn primary" loading="{{loading}}"
            disabled="{{loading || code.length < 6}}" bindtap="onConnect">连接</button>
    <text wx:if="{{error}}" class="error">{{error}}</text>
  </view>

  <view class="foot">
    <text class="hint">控制面：{{baseUrl}}</text>
  </view>
</view>
