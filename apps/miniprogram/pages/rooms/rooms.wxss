.room-card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
}

.room-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.room-name {
  font-size: 15px;
  font-weight: 500;
  color: #0f172a;
}

.room-mode {
  font-size: 11px;
  color: #6b7280;
}

.room-notice {
  display: block;
  margin-top: 6px;
  font-size: 12px;
  color: #444441;
}

.logout {
  margin-top: 24px;
  background: #fff;
  color: #6b7280;
  border: 1px solid #e5e7eb;
}
