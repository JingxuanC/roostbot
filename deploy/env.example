# Roost 控制面环境文件示例（systemd EnvironmentFile / launchd 包装脚本共用）。
# 复制到 /etc/roost/api.env（Linux）或 /usr/local/etc/roost/api.env（macOS），chmod 600。
# 格式：KEY=value，不带 export；值里不要写行尾注释。
# 敏感项：ROOST_SIGNING_SECRET、ROOST_RUNTIME_TOKEN。

# ---- 监听 ----------------------------------------------------------------
# 默认 8787；0 表示内核分配随机端口（仅测试/演示有意义）。
PORT=8787

# 默认 127.0.0.1。只有沙箱需要经 host.openshell.internal 访问控制面时才改成 0.0.0.0，
# 并同时用防火墙限制来源。公网直接暴露不在当前支持范围（见 docs/design/deployment.md §9）。
ROOST_HOST=127.0.0.1

# ---- 数据 ----------------------------------------------------------------
# 默认 <WorkingDirectory>/data/roost.db。设为 memory 表示内存库（重启即丢，仅供演示）。
ROOST_DB=/var/lib/roost/roost.db

# 默认 <WorkingDirectory>/data/attachments；附件需要 SQLite 存储（memory 模式下不可用）。
ROOST_ATTACHMENTS_DIR=/var/lib/roost/attachments

# 附件签名 URL 与 DSH 会话 cookie 的 HMAC 密钥。未配置时每个进程随机生成，
# 重启后旧签名 URL / 旧 cookie 全部失效。生产必填，建议 32 字节以上随机值。
# 敏感项。
ROOST_SIGNING_SECRET=replace-with-32-bytes-of-random

# ---- 内部接口 ------------------------------------------------------------
# 沙箱 room-agent 调 /api/internal/* 的 token。未配置 = 内部接口整体关闭（404）。
# 启用沙箱时必填；与用户会话 token 严格分开。敏感项。
ROOST_RUNTIME_TOKEN=replace-with-a-random-runtime-token

# ---- 调度 ----------------------------------------------------------------
# 未配置或非 1 = 关闭；1 = 启动 10s tick 循环（需要 SQLite；memory 模式不会启动）。
ROOST_SCHEDULER=1

# ---- 连接器网关 ----------------------------------------------------------
# stub（默认）| openconnector | composio。openconnector/composio 需要 ROOST_CONNECTOR_URL，
# 缺失时启动回退 stub：目录为空，connect 返回 501 connector.not_configured。
ROOST_CONNECTOR_BACKEND=stub

# 网关 base URL，只接受 http(s)，可带路径前缀，不能带 query/hash/凭据。
# 例：http://127.0.0.1:8090
ROOST_CONNECTOR_URL=

# 网关 Bearer token；敏感项。未配置时请求不带 Authorization 头。
ROOST_CONNECTOR_TOKEN=

# 单次网关请求超时（毫秒），默认 5000。
ROOST_CONNECTOR_TIMEOUT_MS=5000

# ---- 公网 Origin 与 DSH 地址 ---------------------------------------------
# 公网写操作 Origin 白名单：逗号分隔的精确 origin（scheme://host[:port]）。
# 同源请求（Origin 与 X-Forwarded-Proto + Host 一致）已自动放行，回环继续放行。
# 不接受 * 与 null；留空 = 只信任回环与同源。例：https://roost.example.com
ROOST_ALLOWED_ORIGINS=

# GET /api/config 返回的 DSH 面板完整 origin。配置后优先于自动推导，必须是
# http(s)://host[:port]，不带路径/query。例：https://roost.example.com:8443
ROOST_DSH_PUBLIC_ORIGIN=

# 自动推导 dshBase 时使用的公网端口（nginx 的 8443 监听）。未配置时用实际反代端口
# ROOST_DSH_PROXY_PORT；https+443 / http+80 会自动省略端口。
ROOST_DSH_PROXY_PUBLIC_PORT=8443

# ---- DSH Web 反代 --------------------------------------------------------
# 默认 4098；0 = 不启动第二个监听。必须与 PORT 不同（浏览器按“同 host 不同端口”区分 origin）。
ROOST_DSH_PROXY_PORT=4098

# 反代上游（沙箱内 dsh web）端口，默认 4099。控制面固定连 127.0.0.1:<DSH_WEB_PORT>。
DSH_WEB_PORT=4099

# ---- 沙箱管理 ------------------------------------------------------------
# 只有值为 openshell 时启用 RuntimeManager；其它值/未配置 = 沙箱管理关闭，
# POST /api/workspaces/:id/start 返回 runtime.not_configured。
ROOST_SANDBOX=openshell

# 默认 roost/agent:dev。
ROOST_SANDBOX_IMAGE=roost/agent:dev

# 沙箱访问控制面用的主机名，默认 host.openshell.internal。
ROOST_CP_HOST=host.openshell.internal

# 沙箱访问控制面用的端口，默认等于 PORT。
ROOST_CP_PORT=8787

# 可选；沙箱内 room-agent 的默认 Bot id，未配置时用 selector。
ROOST_BOT_ID=

# 一般不要设置。控制面读 /api/internal/rooms 时用它兜底过滤 workspace；
# 正常应由沙箱进程携带，而不是写进控制面 api.env。
# ROOST_WORKSPACE_ID=

# ---- 仅沙箱/运行时使用（由控制面注入，不要写进 api.env）-------------------
# ROOST_API=http://host.openshell.internal:8787
# ROOST_PROFILE_LOCK_ID=<控制面拉取的 profile lock id>
# ROOST_STATE_FILE=/workspace/.dsh/room-cursors.json
# ROOST_WORKDIR=/workspace
# ROOST_DSH_PROVIDER=deepseek-official
# ROOST_DSH_MODEL=deepseek-chat
# ROOST_DSH_BIN=dsh
# ROOST_DSH_PROFILE=sdk

# ---- 本地开发（不用于部署）--------------------------------------------
# 旧 worker / planA-boot 已删除（E1/E5）；本地用 room-agent + fake-dsh 见 README。
# ROOST_API=http://127.0.0.1:8787
# ROOST_SANDBOX_TURN=dsh
# ROOST_SANDBOX_NAME=
# ROOST_SANDBOX_IDLE_MS=0
# ROOST_DSH_BASE_URL=
# ROOST_DSH_MOCK=1
# ROOST_WS=
# ROOST_IMAGE=roost/agent:dev
# ROOST_RUN=

# ---- 第三方登录（OIDC） ---------------------------------------------------
# 任意标准 OIDC 提供方（Keycloak / Logto / Casdoor / Authentik / Zitadel ...）。
# 变量名里的 <ID> 就是登录页按钮的 provider id（小写），例如 keycloak。
# 四个必填：CLIENT_ID / AUTHORIZE_URL / TOKEN_URL / USERINFO_URL；SECRET 可选（公有客户端）。
# 注册、找回密码、多因素由 IdP 负责；Roost 首次登录自动建本地账号。
# 详见 deploy/oidc/README.md。
# ROOST_OIDC_KEYCLOAK_CLIENT_ID=roostbot
# ROOST_OIDC_KEYCLOAK_SECRET=replace-with-idp-client-secret
# ROOST_OIDC_KEYCLOAK_AUTHORIZE_URL=https://id.example/realms/roostbot/protocol/openid-connect/auth
# ROOST_OIDC_KEYCLOAK_TOKEN_URL=https://id.example/realms/roostbot/protocol/openid-connect/token
# ROOST_OIDC_KEYCLOAK_USERINFO_URL=https://id.example/realms/roostbot/protocol/openid-connect/userinfo
# ROOST_OIDC_KEYCLOAK_SCOPE=openid email profile
# 回调地址默认按请求 Host 推导；反代/自定义域名时显式指定，必须与 IdP 客户端一致。
# ROOST_OIDC_REDIRECT_URI=https://roost.example.com/api/auth/oidc/callback

# ---- 模型 Key / 免费额度 -------------------------------------------------
# BYO Key 的 AES-256-GCM 主密钥：32 字节，base64 或 64 位 hex。生产必填；不配置时
# 用户不能保存自带 Key（平台免费额度仍可用）。
# ROOST_MODEL_KEY_SECRET=<32-byte-base64-or-64-hex>
# 平台兜底 Key：没有 BYO Key 的 workspace 用它，按账号扣免费额度。
# ROOST_MODEL_API_KEY=sk-...
# 平台上游地址（proxy 会自动补 /v1/chat/completions）。
# ROOST_MODEL_UPSTREAM_BASE=https://api.deepseek.com
# 免费额度只允许这个模型（注册赠送默认 100 万 tokens / 90 天）。
# ROOST_FREE_MODEL=deepseek-v4-flash

# ---- 邮件（注册验证 / 重置密码） ------------------------------------------
# 未配置 ROOST_SMTP_HOST 时验证 token 只写 journald，不会真的发邮件。
# 465 用隐式 TLS；587 用 STARTTLS。From 建议使用已配置 SPF/DKIM 的域名。
# 敏感项：ROOST_SMTP_PASS。
# ROOST_SMTP_HOST=smtp.example.com
# ROOST_SMTP_PORT=587
# ROOST_SMTP_SECURE=0
# ROOST_SMTP_USER=no-reply@roostbots.com
# ROOST_SMTP_PASS=replace-with-smtp-password
# ROOST_SMTP_FROM=Roost <no-reply@roostbots.com>
# 邮件里的验证/重置链接使用这个公开地址。
# ROOST_PUBLIC_BASE_URL=https://roostbots.com
