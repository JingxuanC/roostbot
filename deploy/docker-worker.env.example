# Docker runtime worker environment. Do not commit the real token.
PORT=8790
ROOST_DOCKER_WORKER_BIND=172.17.43.58
ROOST_DOCKER_WORKER_TOKEN=replace-with-openssl-rand-hex-32
ROOST_DOCKER_HOST=unix:///var/run/docker28/docker.sock
ROOST_DOCKER_WORKSPACE_ROOT=/var/lib/roost/workspaces
ROOST_DOCKER_IMAGE=roost/agent:multi-runtime
ROOST_DOCKER_ALLOWED_IMAGES=roost/agent:multi-runtime
ROOST_DOCKER_NETWORK=host
