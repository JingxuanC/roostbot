# Control-plane additions for the Docker runtime.
ROOST_RUNTIME_PROVIDER=docker
ROOST_DOCKER_WORKER_URL=http://172.17.43.58:8790
# Optional deterministic multi-host pool (comma-separated):
# ROOST_DOCKER_WORKER_URLS=http://172.17.43.58:8790,http://172.17.43.59:8790
ROOST_DOCKER_WORKER_TOKEN=replace-with-openssl-rand-hex-32
ROOST_DOCKER_IMAGE=roost/agent:multi-runtime
ROOST_CP_HOST=172.17.43.89
ROOST_CP_PORT=8787
ROOST_CP_SCHEME=http
ROOST_CP_API_BASE=http://127.0.0.1:8787
ROOST_MULTI_RUNTIME=1
ROOST_BOT_CREDENTIALS_FILE=/etc/roost/bot-credentials.json
